# Copy to .env and fill in. `.env` is git-ignored; never commit secrets.

# --- App -------------------------------------------------------------------
# Public base URL, used in email links and redirects.
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# --- Database --------------------------------------------------------------
# Matches the Postgres service in docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Needed when self-hosting behind a proxy or running `next start` (Vercel sets it).
AUTH_TRUST_HOST=true

# Optional OAuth providers: each is enabled when both of its values are set.
# GitHub: https://github.com/settings/developers
#   callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Google: https://console.cloud.google.com/apis/credentials
#   callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email -----------------------------------------------------------------
# Leave SMTP_HOST empty in development to print emails (and their links) to
# the terminal. `docker compose up` also starts Mailpit: set SMTP_HOST=localhost
# and SMTP_PORT=1025, then read mail at http://localhost:8025.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Next Enterprise Starter <no-reply@example.com>"
